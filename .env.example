# Порт HTTP-сервера (в production он же отдаёт собранный фронтенд)
PORT=4000

# Каталог для базы данных SQLite и загруженных файлов
DATA_DIR=./data

# Секрет для подписи JWT. Если не задан, сгенерируется и сохранится в DATA_DIR/.jwt-secret
JWT_SECRET=

# Как часто (в минутах) фоновый планировщик проверяет новые релизы артистов. 0 — отключить
SYNC_INTERVAL_MINUTES=60

# Максимальный размер загружаемого аудиофайла, МБ
MAX_UPLOAD_MB=100

# --- Провайдеры ---

# iTunes Search API: витрина (страна), из которой берутся релизы и 30-секундные превью
ITUNES_COUNTRY=US

# Jamendo (полные треки под лицензией CC). Бесплатный client_id: https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=

# ВК Музыка. Пользователи могут подключить собственный токен в интерфейсе («Сервисы»).
# Этот токен используется фоновой синхронизацией, если ни у одного подписчика нет своего.
VK_ACCESS_TOKEN=
VK_API_VERSION=5.131
# Аудио-методы VK API отвечают только клиенту, User-Agent которого совпадает с приложением, выдавшим токен
VK_USER_AGENT=KateMobileAndroid/56 lite-460 (Android 4.4.2; SDK 19; x86; unknown Android SDK built for x86; en)
